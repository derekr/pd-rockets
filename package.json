{
  "name": "rocket-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "bun run build-client.ts",
    "runtime:fetch": "bun run scripts/fetch-datastar-rocket.ts",
    "bundle:browser": "bun run build:client && bun run scripts/package-browser.ts",
    "release:tag": "bun run scripts/tag-release.ts",
    "demo": "bun run runtime:fetch && bun run build:client && bun run examples/hono-datastar/server.tsx",
    "build:site": "bun run build:client && bun run site/build.tsx",
    "serve:site": "bun run build:site && bun run site/serve.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:perf": "PERF=1 playwright test tests/browser/performance.pw.ts --workers=1 --reporter=list",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "bun-types": "^1.4.2",
    "oxfmt": "0.68.0",
    "typescript": "^5"
  }
}
